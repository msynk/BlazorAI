@page "/Error"
@using System.Diagnostics
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Error — Blazor.AI</PageTitle>

<div class="demo__page">
    <h1>Something went wrong</h1>
    <p>An error occurred while processing your request. <a href="">Start from the beginning</a>.</p>

    @if (ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@RequestId</code>
        </p>
    }

    <p class="demo__note">
        Run in the <strong>Development</strong> environment to see the details of the failure. Never
        enable it for a deployed application: it can show sensitive information to end users.
    </p>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
