<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="stylesheet" href="@Assets["_content/Blazor.AI.Components/blazor-ai.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <script>
        // Applied before first paint so a stored theme never flashes the other one first.
        window.demoTheme = {
            get: () => { try { return localStorage.getItem('demo-theme') || 'system'; } catch { return 'system'; } },
            set: (value) => {
                try { localStorage.setItem('demo-theme', value); } catch { }
                if (value === 'system') document.documentElement.removeAttribute('data-bai-theme');
                else document.documentElement.setAttribute('data-bai-theme', value);
            },
        };
        window.demoTheme.set(window.demoTheme.get());
    </script>
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />

    <div id="blazor-error-ui" data-nosnippet>
        Something went wrong. The page may no longer respond.
        <a href="." class="reload">Reload</a>
        <span class="dismiss" role="button" tabindex="0" aria-label="Dismiss">&#x2715;</span>
    </div>

    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Pages marked [ExcludeFromInteractiveRouting], such as the error page, render statically so
    // they can read the HttpContext. Everything else is interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveAuto : null;
}
