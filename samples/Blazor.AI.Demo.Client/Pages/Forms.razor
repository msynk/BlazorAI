@page "/forms"
@implements IAsyncDisposable

<DemoPage Title="AI forms"
          Summary="The model proposes a form from a JSON Schema, the user corrects it, and the corrected values are what execute.">
    <ChildContent>
        <CascadingValue Name="BookingSubmitted" Value="_onSubmitted" IsFixed="true">
            <AiChat Session="_session"
                    EmptyTitle="Ask it to book something"
                    Suggestions="@(new[] { "Book a table for Friday" })" />
        </CascadingValue>
    </ChildContent>

    <Aside>
        <h3>Confirmation, not guessing</h3>
        <p>
            The model produced a schema, not a booking. The form is built from that schema, validated
            in the application rather than by the model, and only submits when it is valid.
        </p>
        <p>
            A structured renderer registered for the <code>booking_form</code> schema replaces the
            default view, so the user sees a form rather than the JSON behind it.
        </p>
        <CodeBlockView Language="csharp" Code="@Snippet" />
        @if (_values is { } values)
        {
            <h3>Submitted values</h3>
            <ul>
                @foreach (var (key, value) in values)
                {
                    <li><strong>@key</strong>: @value</li>
                }
            </ul>
        }
        <p class="demo__note">
            Fields appear as the schema streams in. Anything already typed survives a new field
            arriving.
        </p>
    </Aside>
</DemoPage>

@code {
    private readonly ChatSession _session = new(DemoInteractiveTransports.ProposesForm());
    private IReadOnlyDictionary<string, string?>? _values;
    private EventCallback<IReadOnlyDictionary<string, string?>> _onSubmitted;

    protected override void OnInitialized() =>
        _onSubmitted = EventCallback.Factory.Create<IReadOnlyDictionary<string, string?>>(this, values => _values = values);

    private const string Snippet = """
        renderers.RegisterStructured("booking_form", context => builder =>
        {
            builder.OpenComponent<BookingForm>(0);
            builder.AddComponentParameter(1, "Part", context.Part);
            builder.CloseComponent();
        });
        """;

    public ValueTask DisposeAsync() => _session.DisposeAsync();
}
