@namespace Blazor.AI.Components
@inherits AiComponentBase

@*
    Renders Markdown that is still being written.

    Holds one incremental parser for the lifetime of the component, so text already seen is parsed
    once no matter how many deltas arrive. That is the difference between a long streamed answer
    costing linear work and quadratic work.

    The parser is built from the cascaded Markdown options, and rebuilt if a different options
    instance is cascaded, so the parser and the renderer always agree on what is enabled.
*@

<MarkdownView Document="_document"
              Citations="Citations"
              OnCitationClick="OnCitationClick"
              ShowCaret="@IsStreaming"
              Class="@Class" />

@code {
    private IncrementalMarkdownParser? _parser;
    private MarkdownOptions? _parserOptions;
    private MarkdownDocument? _document;
    private string? _lastText;
    private bool _lastStreaming = true;

    /// <summary>The Markdown received so far.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Whether more text is expected.</summary>
    [Parameter]
    public bool IsStreaming { get; set; }

    /// <summary>Citations that inline markers resolve against.</summary>
    [Parameter]
    public IReadOnlyList<Citation>? Citations { get; set; }

    /// <summary>Raised when the user activates a citation marker.</summary>
    [Parameter]
    public EventCallback<Citation> OnCitationClick { get; set; }

    /// <summary>Extra CSS classes.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        var markdownOptions = Options.Markdown;
        if (_parser is null || !ReferenceEquals(_parserOptions, markdownOptions))
        {
            _parser = new IncrementalMarkdownParser(markdownOptions);
            _parserOptions = markdownOptions;
            _lastText = null;
        }

        if (_lastText == Text && _lastStreaming == IsStreaming) return;

        _lastText = Text;
        _lastStreaming = IsStreaming;
        _document = _parser.Parse(Text, !IsStreaming);
    }

    /// <inheritdoc />
    /// <remarks>
    /// The base class is disposed asynchronously, and Blazor calls only that on a component which
    /// implements both interfaces, so the cleanup lives here rather than in <c>Dispose</c>.
    /// </remarks>
    protected override ValueTask DisposeCoreAsync()
    {
        _parser?.Reset();
        _parser = null;
        _document = null;
        return ValueTask.CompletedTask;
    }
}
