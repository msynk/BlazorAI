@namespace Blazor.AI.Components
@inherits ComponentBase

@*
    A small inline SVG icon set.

    Inline rather than a font or sprite sheet so icons inherit currentColor, need no extra request,
    and work in a component library that must not assume anything about the host page. Register a
    replacement for the whole set by passing custom markup into the components that take an icon
    template.
*@

<svg class="bai-icon @Class" viewBox="0 0 24 24" aria-hidden="true" focusable="false" @attributes="Attributes">
    @Path(Name)
</svg>

@code {
    /// <summary>The icon to draw. Unknown names render nothing rather than a broken glyph.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Extra CSS classes.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Any other attributes, splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }

    private static RenderFragment Path(string name) => name switch
    {
        "send" => @<path d="M4 12l16-8-6 8 6 8z" />,
        "stop" => @<rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor" stroke="none" />,
        "copy" => @<g><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h8" /></g>,
        "check" => @<path d="M5 13l4 4L19 7" />,
        "refresh" => @<g><path d="M20 12a8 8 0 1 1-2.6-5.9" /><path d="M20 4v5h-5" /></g>,
        "edit" => @<g><path d="M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16z" /><path d="M14 6l4 4" /></g>,
        "thumb-up" => @<path d="M7 21V10l4-7a2 2 0 0 1 3 2l-1 4h5a2 2 0 0 1 2 2.4l-1.4 7A2 2 0 0 1 16.6 21z" />,
        "thumb-down" => @<path d="M17 3v11l-4 7a2 2 0 0 1-3-2l1-4H6a2 2 0 0 1-2-2.4l1.4-7A2 2 0 0 1 7.4 3z" />,
        "chevron-right" => @<path d="M9 5l7 7-7 7" />,
        "chevron-down" => @<path d="M5 9l7 7 7-7" />,
        "chevron-up" => @<path d="M19 15l-7-7-7 7" />,
        "paperclip" => @<path d="M20 11l-8.5 8.5a4.6 4.6 0 0 1-6.5-6.5l9-9a3.1 3.1 0 0 1 4.4 4.4l-9 9a1.5 1.5 0 0 1-2.2-2.2L14 9" />,
        "mic" => @<g><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></g>,
        "close" => @<path d="M6 6l12 12M18 6L6 18" />,
        "download" => @<g><path d="M12 4v11" /><path d="M7 11l5 5 5-5" /><path d="M5 20h14" /></g>,
        "expand" => @<g><path d="M4 10V4h6" /><path d="M20 14v6h-6" /><path d="M4 4l6 6" /><path d="M20 20l-6-6" /></g>,
        "collapse" => @<g><path d="M10 4v6H4" /><path d="M14 20v-6h6" /><path d="M4 20l6-6" /><path d="M20 4l-6 6" /></g>,
        "alert" => @<g><path d="M12 3l9 16H3z" /><path d="M12 9v5M12 17h.01" /></g>,
        "tool" => @<path d="M14.5 3.5a5 5 0 0 0-6 6.6L3 15.6V21h5.4l5.5-5.5a5 5 0 0 0 6.6-6.6L17 12l-3-1-1-3z" />,
        "sparkle" => @<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z" />,
        "file" => @<g><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5" /></g>,
        "image" => @<g><rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="10" r="1.6" /><path d="M21 16l-5-5-7 7" /></g>,
        "external" => @<g><path d="M14 4h6v6" /><path d="M20 4l-9 9" /><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" /></g>,
        "plus" => @<path d="M12 5v14M5 12h14" />,
        "trash" => @<g><path d="M4 7h16" /><path d="M9 7V5h6v2" /><path d="M6 7l1 13h10l1-13" /></g>,
        "arrow-down" => @<g><path d="M12 5v14" /><path d="M6 13l6 6 6-6" /></g>,
        "search" => @<g><circle cx="11" cy="11" r="6" /><path d="M20 20l-4.3-4.3" /></g>,
        "globe" => @<g><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18" /></g>,
        "code" => @<g><path d="M9 8l-5 4 5 4" /><path d="M15 8l5 4-5 4" /></g>,
        "brain" => @<path d="M9 4a3 3 0 0 0-3 3 3 3 0 0 0-1 5.8V15a3 3 0 0 0 3 3h1v2h4v-2h1a3 3 0 0 0 3-3v-2.2A3 3 0 0 0 18 7a3 3 0 0 0-3-3z" />,
        "layers" => @<g><path d="M12 3l9 5-9 5-9-5z" /><path d="M3 13l9 5 9-5" /></g>,
        "user" => @<g><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></g>,
        "settings" => @<g><circle cx="12" cy="12" r="3" /><path d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6l1.4 1.4m10 10l1.4 1.4m0-12.8l-1.4 1.4m-10 10l-1.4 1.4" /></g>,
        _ => @<text></text>,
    };
}
