@namespace Blazor.AI.Components
@inherits AiComponentBase

@*
    A grouped model picker driven by the registered catalogue.

    A native select rather than a custom popover: it is keyboard accessible, screen-reader correct,
    and renders as the platform picker on mobile, none of which a hand-rolled listbox gets for free.
*@

@if (_models.Count > 0)
{
    <select class="bai-select"
            style="width:auto"
            aria-label="@Strings.Model"
            title="@_selected?.Description"
            disabled="@Disabled"
            value="@_selected?.ModelId"
            @onchange="OnChangedAsync">
        @foreach (var group in _groups)
        {
            @if (group.Key is { Length: > 0 } label)
            {
                <optgroup label="@label">
                    @foreach (var model in group)
                    {
                        <option value="@model.ModelId">@OptionLabel(model)</option>
                    }
                </optgroup>
            }
            else
            {
                @foreach (var model in group)
                {
                    <option value="@model.ModelId">@OptionLabel(model)</option>
                }
            }
        }
    </select>
}

@code {
    private List<AiModel> _models = [];
    private List<IGrouping<string?, AiModel>> _groups = [];
    private AiModel? _selected;
    private string? _announcedId;

    /// <summary>The catalogue to offer. Falls back to the registered one.</summary>
    [Parameter]
    public IModelCatalog? Catalog { get; set; }

    /// <summary>Restricts the list, for hosts that filter by entitlement.</summary>
    [Parameter]
    public IReadOnlyList<AiModel>? Models { get; set; }

    /// <summary>The selected model.</summary>
    /// <remarks>
    /// When this names no model in the list, because it is unset, deprecated, or filtered out, the
    /// picker selects the catalogue default or the first model and raises
    /// <see cref="ModelIdChanged"/> and <see cref="OnModelSelected"/> for it, so a bound value
    /// never disagrees with what the picker shows.
    /// </remarks>
    [Parameter]
    public string? ModelId { get; set; }

    /// <summary>Raised when the selection changes, so the value can be bound.</summary>
    [Parameter]
    public EventCallback<string> ModelIdChanged { get; set; }

    /// <summary>Raised with the full model record when the selection changes.</summary>
    [Parameter]
    public EventCallback<AiModel> OnModelSelected { get; set; }

    /// <summary>Disables the picker, for example while a turn is in flight.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Include models marked deprecated, labelled as such.</summary>
    [Parameter]
    public bool ShowDeprecated { get; set; }

    /// <summary>
    /// Offer only models that declare every one of these capabilities, for example
    /// <see cref="ModelCapabilities.Vision"/> for a composer that has images staged.
    /// </summary>
    [Parameter]
    public ModelCapabilities RequiredCapabilities { get; set; } = ModelCapabilities.None;

    /// <summary>The model the picker shows, which may differ from <see cref="ModelId"/> until the change is raised.</summary>
    public AiModel? Selected => _selected;

    [Inject]
    private IServiceProvider Services { get; set; } = default!;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        var catalog = Catalog ?? Services.GetService(typeof(IModelCatalog)) as IModelCatalog;
        var source = Models ?? catalog?.Models ?? [];

        _models = source
            .Where(m => ShowDeprecated || !m.IsDeprecated)
            .Where(m => m.Supports(RequiredCapabilities))
            .ToList();

        var grouped = _models.Any(m => GroupLabel(m, catalog) is { Length: > 0 });
        _groups = _models
            .GroupBy(m => grouped ? GroupLabel(m, catalog) ?? Strings.OtherModels : null)
            .ToList();

        _selected = _models.FirstOrDefault(m => m.ModelId == ModelId)
            ?? _models.FirstOrDefault(m => m.ModelId == catalog?.DefaultModel?.ModelId)
            ?? _models.FirstOrDefault();
    }

    /// <inheritdoc />
    /// <remarks>
    /// The browser shows the first option when the bound value matches none, but nothing tells the
    /// application so. Raising the change here, after the render, keeps the bound value and the
    /// picker in step without re-entering the parent's render.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_selected is not { } selected || selected.ModelId == ModelId) return;
        if (_announcedId == selected.ModelId) return;

        _announcedId = selected.ModelId;
        ModelId = selected.ModelId;
        await ModelIdChanged.InvokeAsync(selected.ModelId);
        await OnModelSelected.InvokeAsync(selected);
    }

    private async Task OnChangedAsync(ChangeEventArgs args)
    {
        var id = args.Value?.ToString();
        if (id is null) return;

        ModelId = id;
        _announcedId = id;
        _selected = _models.FirstOrDefault(m => m.ModelId == id);

        await ModelIdChanged.InvokeAsync(id);
        if (_selected is not null) await OnModelSelected.InvokeAsync(_selected);
    }

    private static string? GroupLabel(AiModel model, IModelCatalog? catalog) =>
        model.Family ?? (model.ProviderId is { } id ? catalog?.FindProvider(id)?.Name ?? id : null);

    private string OptionLabel(AiModel model) => model.IsDeprecated ? Strings.ModelDeprecated(model.Name) : model.Name;
}
