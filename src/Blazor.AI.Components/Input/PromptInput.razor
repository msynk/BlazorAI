@namespace Blazor.AI.Components
@inherits AiComponentBase
@inject AiInterop Interop

@*
    The composer: text, attachments, slash commands, mentions, dictation, and the send or stop
    button.

    Enter sends and Shift+Enter inserts a newline, which is what people expect from a chat box and
    the opposite of what a plain textarea does. The send button becomes a stop button while a turn
    is in flight rather than sitting disabled beside one, because stopping is the action a user
    actually wants at that moment.
*@

<div class="bai-composer" @ref="_root">
    @if (_dragging)
    {
        <div class="bai-composer__drop">@Strings.DropFiles</div>
    }

    @if (_attachments.Count > 0)
    {
        <div class="bai-attachments">
            @foreach (var attachment in _attachments)
            {
                <AttachmentChip Attachment="attachment" OnRemove="RemoveAttachmentAsync" @key="attachment.AttachmentId" />
            }
        </div>
    }

    @if (_rejections.Count > 0)
    {
        @* A dropped file is never dropped silently: say which file was turned away and why. *@
        <div class="bai-composer__notice" role="alert">
            <AiIcon Name="alert" />
            <div class="bai-composer__notice-text">
                @foreach (var rejection in _rejections)
                {
                    <div>@RejectionMessage(rejection)</div>
                }
            </div>
            <button type="button"
                    class="bai-btn bai-btn--icon"
                    title="@Strings.Dismiss"
                    aria-label="@Strings.Dismiss"
                    @onclick="DismissRejections">
                <AiIcon Name="close" />
            </button>
        </div>
    }

    @if (MenuOpen)
    {
        <div class="bai-menu bai-menu--above"
             role="listbox"
             id="@_menuId"
             aria-label="@(_menuTrigger == '/' ? Strings.Commands : Strings.Mentions)">
            @for (var i = 0; i < _menuItems.Count; i++)
            {
                var index = i;
                var item = _menuItems[i];
                <button type="button"
                        role="option"
                        id="@OptionId(index)"
                        tabindex="-1"
                        aria-selected="@(index == _menuIndex ? "true" : "false")"
                        class="bai-menu__item @(index == _menuIndex ? "bai-menu__item--active" : null)"
                        @onclick="() => AcceptMenuItemAsync(index)">
                    @if (item.Icon is { Length: > 0 } icon)
                    {
                        <AiIcon Name="@icon" />
                    }
                    <span class="bai-menu__label">@item.Label</span>
                    @if (item.Description is { Length: > 0 } description)
                    {
                        <span class="bai-menu__hint">@description</span>
                    }
                </button>
            }
        </div>
    }

    <div class="bai-composer__row">
        @if (Leading is not null)
        {
            <div class="bai-composer__tools">@Leading</div>
        }

        @* A combobox rather than a plain textbox: the slash and mention menu is a listbox popup that
           the arrow keys drive, and aria-activedescendant tells assistive technology which option
           those keys have reached while focus stays in the text. *@
        <textarea @ref="_textarea"
                  class="bai-composer__textarea"
                  rows="1"
                  placeholder="@(Placeholder ?? Strings.PromptPlaceholder)"
                  aria-label="@(Placeholder ?? Strings.PromptPlaceholder)"
                  role="combobox"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  aria-expanded="@(MenuOpen ? "true" : "false")"
                  aria-controls="@(MenuOpen ? _menuId : null)"
                  aria-activedescendant="@(MenuOpen ? OptionId(_menuIndex) : null)"
                  aria-describedby="@(MaxLength is not null ? _counterId : null)"
                  data-bai-menu-open="@(MenuOpen ? "true" : null)"
                  maxlength="@MaxLength"
                  disabled="@Disabled"
                  value="@Value"
                  @oninput="OnInputAsync"
                  @onkeydown="OnKeyDownAsync"
                  @onkeyup="OnKeyUpAsync"></textarea>

        <div class="bai-composer__tools">
            @if (ShowAttachments)
            {
                @* A real button carries the accessible name and the focus ring; the file input is
                   kept, out of the tab order, because only it can open the picker and deliver files. *@
                <button type="button"
                        class="bai-btn bai-btn--icon bai-composer__attach"
                        title="@Strings.AttachFile"
                        aria-label="@Strings.AttachFile"
                        disabled="@Disabled"
                        @onclick="OpenFilePickerAsync">
                    <AiIcon Name="paperclip" />
                </button>
                <InputFile @ref="_fileInput"
                           OnChange="OnFilesSelectedAsync"
                           multiple
                           accept="@EffectiveAccept"
                           class="bai-sr-only"
                           tabindex="-1"
                           aria-hidden="true" />
            }

            @if (ShowDictation)
            {
                <VoiceInput Language="@DictationLanguage"
                            OnTranscript="OnTranscriptAsync"
                            OnInterim="OnInterimAsync"
                            OnListeningChanged="OnListeningChangedAsync" />
            }

            @if (Trailing is not null)
            {
                @Trailing
            }

            @* One element for send and stop, so focus stays on it when a turn starts or ends. *@
            <button type="button"
                    @key="@SendButtonKey"
                    class="bai-btn bai-composer__send @(IsGenerating ? "bai-btn--icon bai-btn--outline" : "bai-btn--primary")"
                    title="@(IsGenerating ? Strings.Stop : Strings.Send)"
                    aria-label="@(IsGenerating ? Strings.Stop : Strings.Send)"
                    disabled="@(!IsGenerating && !CanSubmit)"
                    @onclick="SendOrStopAsync">
                <AiIcon Name="@(IsGenerating ? "stop" : "send")" />
            </button>
        </div>
    </div>

    @if (_interim is { Length: > 0 } interim)
    {
        @* Provisional dictation, shown but not announced: it changes with every syllable. *@
        <div class="bai-composer__interim" aria-hidden="true">@interim</div>
    }

    @if (Hint is not null || MaxLength is not null)
    {
        <div class="bai-composer__footer">
            @if (Hint is not null)
            {
                <div class="bai-composer__hint">@Hint</div>
            }

            @if (MaxLength is { } max)
            {
                <div id="@_counterId"
                     class="bai-composer__counter @(NearLimit ? "bai-composer__counter--near" : null) @(Value.Length > max ? "bai-composer__counter--over" : null)"
                     aria-hidden="true">@Strings.CharacterCount(Value.Length, max)</div>
            }
        </div>
    }

    @if (MaxLength is { } limit)
    {
        @* Quiet until the limit is close, then a polite count so a screen reader user is not cut off. *@
        <div class="bai-sr-only" role="status" aria-live="polite">
            @if (NearLimit)
            {
                @Strings.CharactersRemaining(Math.Max(0, limit - Value.Length))
            }
        </div>
    }
</div>

@code {
    /// <summary>The default for <see cref="MaxAttachmentSize"/>: 10 MB.</summary>
    public const long DefaultMaxAttachmentSize = 10 * 1024 * 1024;

    /// <summary>The default for <see cref="MaxAttachments"/>.</summary>
    public const int DefaultMaxAttachments = 20;

    /// <summary>The default for <see cref="MaxInlineSize"/>: 256 KB.</summary>
    public const long DefaultMaxInlineSize = 256 * 1024;

    private const string SendButtonKey = "send";

    // Enough to explain a multi-file drop without the notice outgrowing the composer.
    private const int MaxNotices = 3;

    private readonly List<Attachment> _attachments = [];
    private readonly Dictionary<string, StagedResources> _staged = [];
    private readonly List<AttachmentRejection> _rejections = [];
    private readonly List<MenuEntry> _menuItems = [];
    private readonly string _menuId = $"bai-menu-{Guid.NewGuid():N}";
    private readonly string _counterId = $"bai-counter-{Guid.NewGuid():N}";
    private ElementReference _root;
    private ElementReference _textarea;
    private InputFile? _fileInput;
    private DotNetObjectReference<PromptInput>? _self;
    private long? _registeredMaxSize;
    private bool? _registeredSubmitOnEnter;
    private string? _restoredDraftKey;
    private int? _pendingCaret;
    private bool _dragging;
    private bool _disposed;
    private string? _interim;
    private int _menuIndex;
    private char _menuTrigger;
    private int _menuStart = -1;
    private int _menuEnd = -1;

    /// <summary>The composer text.</summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>Raised whenever the text changes, so the value can be bound.</summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Raised when the user submits. Receives the text and any attachments staged in the composer.
    /// </summary>
    [Parameter]
    public EventCallback<PromptSubmission> OnSubmit { get; set; }

    /// <summary>Raised when the user asks to stop the current turn.</summary>
    [Parameter]
    public EventCallback OnStop { get; set; }

    /// <summary>The session, which supplies generation state and receives submissions.</summary>
    [Parameter]
    public ChatSession? Session { get; set; }

    /// <summary>Whether a turn is in flight. Falls back to the session when unset.</summary>
    [Parameter]
    public bool? Generating { get; set; }

    /// <summary>Placeholder text.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Disables the whole composer.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Offer the attachment button and accept dropped or pasted files.</summary>
    /// <remarks>
    /// Also subject to the model: when <see cref="Model"/> or <see cref="Capabilities"/> is set and
    /// declares neither <see cref="ModelCapabilities.Vision"/>, <see cref="ModelCapabilities.Documents"/>
    /// nor <see cref="ModelCapabilities.Audio"/>, attachments are hidden whatever this says.
    /// </remarks>
    [Parameter]
    public bool AllowAttachments { get; set; } = true;

    /// <summary>Offer the dictation button, when the browser supports it.</summary>
    /// <remarks>
    /// Hidden when <see cref="Model"/> or <see cref="Capabilities"/> is set and does not declare
    /// <see cref="ModelCapabilities.Audio"/>.
    /// </remarks>
    [Parameter]
    public bool AllowDictation { get; set; }

    /// <summary>The dictation language. Defaults to the browser language.</summary>
    [Parameter]
    public string? DictationLanguage { get; set; }

    /// <summary>
    /// The file types to accept, in the syntax of the HTML <c>accept</c> attribute: extensions such
    /// as <c>.pdf</c>, MIME types such as <c>image/png</c>, or wildcards such as <c>image/*</c>.
    /// </summary>
    /// <remarks>
    /// Applied to the file picker and also checked for pasted and dropped files, which the browser
    /// does not filter. When unset, the accepted types follow the model's capabilities if a
    /// <see cref="Model"/> or <see cref="Capabilities"/> is given, and every type is accepted
    /// otherwise.
    /// </remarks>
    [Parameter]
    public string? Accept { get; set; }

    /// <summary>
    /// The largest file the composer will stage, in bytes. Defaults to
    /// <see cref="DefaultMaxAttachmentSize"/>.
    /// </summary>
    /// <remarks>
    /// Checked in the browser before a pasted or dropped file is read, so an oversized file costs
    /// nothing to turn away. Files within the limit are streamed rather than sent in one message, so
    /// the limit is not tied to the SignalR message size on Blazor Server.
    /// </remarks>
    [Parameter]
    public long MaxAttachmentSize { get; set; } = DefaultMaxAttachmentSize;

    /// <summary>
    /// The most files that can be staged at once. Defaults to <see cref="DefaultMaxAttachments"/>.
    /// </summary>
    [Parameter]
    public int MaxAttachments { get; set; } = DefaultMaxAttachments;

    /// <summary>
    /// The largest file whose bytes are held in memory, in bytes. Defaults to
    /// <see cref="DefaultMaxInlineSize"/>.
    /// </summary>
    /// <remarks>
    /// A file within this size is buffered and carries <see cref="Attachment.Data"/> and a data URL.
    /// A larger file is kept in the browser and read through <see cref="Attachment.ContentFactory"/>
    /// when something opens it, so a circuit never holds megabytes per attachment. Image thumbnails
    /// are object URLs made in the browser either way.
    /// </remarks>
    [Parameter]
    public long MaxInlineSize { get; set; } = DefaultMaxInlineSize;

    /// <summary>The most characters the text may hold. Unlimited when unset.</summary>
    /// <remarks>
    /// Enforced by the textarea and shown as a counter under the composer, which is announced
    /// politely once the limit is close.
    /// </remarks>
    [Parameter]
    public int? MaxLength { get; set; }

    /// <summary>
    /// A key under which the draft text is kept in the browser's session storage, so it survives a
    /// reload or a dropped circuit. Drafts are not persisted when unset.
    /// </summary>
    /// <remarks>
    /// Restored when the composer first renders with an empty value, saved on every change, and
    /// cleared on submit. Use a key that identifies the conversation, so drafts do not bleed between
    /// them.
    /// </remarks>
    [Parameter]
    public string? DraftKey { get; set; }

    /// <summary>
    /// The model the prompt is for. Its capabilities decide whether attachments and dictation are
    /// offered and which file types the picker accepts.
    /// </summary>
    [Parameter]
    public AiModel? Model { get; set; }

    /// <summary>
    /// The capabilities to assume, when there is no <see cref="Model"/> record or its capabilities
    /// should be overridden.
    /// </summary>
    [Parameter]
    public ModelCapabilities? Capabilities { get; set; }

    /// <summary>Commands offered when the user types a forward slash.</summary>
    [Parameter]
    public IReadOnlyList<SlashCommand>? Commands { get; set; }

    /// <summary>Items offered when the user types an at sign.</summary>
    [Parameter]
    public IReadOnlyList<MentionItem>? Mentions { get; set; }

    /// <summary>Content placed before the textarea, such as a model picker.</summary>
    [Parameter]
    public RenderFragment? Leading { get; set; }

    /// <summary>Content placed between the tools and the send button.</summary>
    [Parameter]
    public RenderFragment? Trailing { get; set; }

    /// <summary>A hint rendered under the composer.</summary>
    [Parameter]
    public RenderFragment? Hint { get; set; }

    /// <summary>
    /// Raised for each file the composer turns away: too large, too many, not an accepted type, or
    /// unreadable.
    /// </summary>
    /// <remarks>
    /// The composer already tells the user with an inline message. Handle this to log the rejection
    /// or to offer another route, such as uploading the file to the application's own storage.
    /// </remarks>
    [Parameter]
    public EventCallback<AttachmentRejection> OnAttachmentRejected { get; set; }

    /// <summary>The attachments currently staged.</summary>
    public IReadOnlyList<Attachment> Attachments => _attachments;

    /// <summary>The capabilities in force: <see cref="Capabilities"/>, else those of <see cref="Model"/>.</summary>
    public ModelCapabilities? EffectiveCapabilities => Capabilities ?? Model?.Capabilities;

    private bool IsGenerating => Generating ?? Session?.IsGenerating ?? false;

    private bool MenuOpen => _menuItems.Count > 0;

    private bool ShowAttachments => AllowAttachments
        && (EffectiveCapabilities is not { } capabilities
            || (capabilities & (ModelCapabilities.Vision | ModelCapabilities.Documents | ModelCapabilities.Audio)) != 0);

    private bool ShowDictation => AllowDictation
        && (EffectiveCapabilities is not { } capabilities || capabilities.HasFlag(ModelCapabilities.Audio));

    private string? EffectiveAccept => Accept ?? AcceptFromCapabilities();

    private bool NearLimit => MaxLength is { } max && max - Value.Length <= Math.Max(10, max / 10);

    private bool CanSubmit => !Disabled && !IsGenerating
        && (!string.IsNullOrWhiteSpace(Value) || _attachments.Count > 0)
        && (MaxLength is not { } max || Value.Length <= max);

    /// <summary>Puts the caret in the composer.</summary>
    /// <returns>A task that completes once focus has been requested.</returns>
    public ValueTask FocusAsync() => Interop.InvokeVoidAsync("focusElement", _textarea, false);

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;

        // Registered again whenever the limit changes, because the browser checks it before reading.
        if (ShowAttachments && _registeredMaxSize != MaxAttachmentSize)
        {
            _self ??= DotNetObjectReference.Create(this);
            _registeredMaxSize = MaxAttachmentSize;
            await Interop.InvokeVoidAsync("registerPaste", _textarea, _self, MaxAttachmentSize);
            await Interop.InvokeVoidAsync("registerDrop", _root, _self, MaxAttachmentSize);
        }
        else if (!ShowAttachments && _registeredMaxSize is not null)
        {
            _registeredMaxSize = null;
            await Interop.InvokeVoidAsync("unregisterPaste", _textarea);
            await Interop.InvokeVoidAsync("unregisterDrop", _root);
        }

        // The key guard is registered again when the submit key changes, not only once.
        if (_registeredSubmitOnEnter != Options.SubmitOnEnter)
        {
            _registeredSubmitOnEnter = Options.SubmitOnEnter;
            await Interop.InvokeVoidAsync("registerSubmitKey", _textarea, Options.SubmitOnEnter);
        }

        if (!string.Equals(_restoredDraftKey, DraftKey, StringComparison.Ordinal))
        {
            _restoredDraftKey = DraftKey;
            if (DraftKey is not null && string.IsNullOrEmpty(Value))
            {
                var draft = await Interop.InvokeAsync<string?>("readDraft", DraftKey);
                if (!string.IsNullOrEmpty(draft) && !_disposed)
                {
                    Value = draft;
                    await ValueChanged.InvokeAsync(Value);
                    StateHasChanged();
                }
            }
        }

        if (_disposed) return;
        await Interop.InvokeVoidAsync("autoResize", _textarea, Options.MaxComposerRows);

        // Set after the render that wrote the new text, which otherwise leaves the caret at the end.
        if (_pendingCaret is { } caret)
        {
            _pendingCaret = null;
            await Interop.InvokeVoidAsync("setCaret", _textarea, caret);
        }
    }

    private async Task OnInputAsync(ChangeEventArgs args)
    {
        Value = args.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
        await SaveDraftAsync();
        await UpdateMenuAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        // Enter during IME composition confirms the candidate; it is never a submit or a menu choice.
        if (IsComposing(args)) return;

        if (MenuOpen)
        {
            switch (args.Key)
            {
                case "ArrowDown":
                    _menuIndex = (_menuIndex + 1) % _menuItems.Count;
                    return;
                case "ArrowUp":
                    _menuIndex = (_menuIndex - 1 + _menuItems.Count) % _menuItems.Count;
                    return;
                case "Enter" or "Tab":
                    await AcceptMenuItemAsync(_menuIndex);
                    return;
                case "Escape":
                    CloseMenu();
                    return;
            }
        }

        // Escape closes the menu first; with no menu open it stops the turn in flight.
        if (args.Key is "Escape")
        {
            if (IsGenerating) await StopAsync();
            return;
        }

        if (args.Key is not "Enter" || args.ShiftKey || args.AltKey) return;

        var withModifier = args.CtrlKey || args.MetaKey;
        if (!withModifier && !Options.SubmitOnEnter) return;

        // The newline was already suppressed in the browser by the registered submit-key guard.
        await SubmitAsync();
    }

    /// <remarks>
    /// Moving the caret with the keyboard can carry it into or out of a slash or mention token, so
    /// the menu is reconsidered once the caret has settled.
    /// </remarks>
    private Task OnKeyUpAsync(KeyboardEventArgs args) => args.Key is "ArrowLeft" or "ArrowRight" or "Home" or "End"
        ? UpdateMenuAsync()
        : Task.CompletedTask;

    private static bool IsComposing(KeyboardEventArgs args) => args.IsComposing || args.Key is "Process";

    private Task SendOrStopAsync() => IsGenerating ? StopAsync() : SubmitAsync();

    private async Task SubmitAsync()
    {
        if (!CanSubmit) return;

        var submission = new PromptSubmission(Value.Trim(), _attachments.ToArray());

        Value = string.Empty;
        _attachments.Clear();
        // The message owns the attachments now: their browser streams and previews go with them.
        _staged.Clear();
        _rejections.Clear();
        _interim = null;
        CloseMenu();

        await ValueChanged.InvokeAsync(Value);
        if (DraftKey is not null) await Interop.InvokeVoidAsync("clearDraft", DraftKey);
        await OnSubmit.InvokeAsync(submission);
        await Interop.InvokeVoidAsync("autoResize", _textarea, Options.MaxComposerRows);

        if (Session is not null && !OnSubmit.HasDelegate)
        {
            await Session.SubmitAsync(submission.Text, submission.Attachments);
        }
    }

    private async Task StopAsync()
    {
        Session?.Stop();
        await OnStop.InvokeAsync();
    }

    private async Task OnTranscriptAsync(string transcript)
    {
        _interim = null;
        Value = string.IsNullOrEmpty(Value) ? transcript : $"{Value} {transcript}";
        if (MaxLength is { } max && Value.Length > max) Value = Value[..max];
        await ValueChanged.InvokeAsync(Value);
        await SaveDraftAsync();
    }

    private Task OnInterimAsync(string interim)
    {
        _interim = interim;
        return Task.CompletedTask;
    }

    private Task OnListeningChangedAsync(bool listening)
    {
        if (!listening) _interim = null;
        return Task.CompletedTask;
    }

    private ValueTask SaveDraftAsync() => DraftKey is null
        ? ValueTask.CompletedTask
        : Interop.InvokeVoidAsync("writeDraft", DraftKey, Value);

    private async Task OpenFilePickerAsync()
    {
        if (_fileInput?.Element is { } input) await Interop.InvokeVoidAsync("clickElement", input);
    }

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs args)
    {
        IReadOnlyList<IBrowserFile> files;
        try
        {
            // Every selected file is considered: asking for fewer than were picked throws and would
            // lose the whole selection.
            files = args.GetMultipleFiles(Math.Max(1, args.FileCount));
        }
        catch (InvalidOperationException)
        {
            await RejectAsync(string.Empty, string.Empty, 0, AttachmentRejectionReason.TooMany);
            return;
        }

        var position = -1;
        foreach (var file in files)
        {
            position++;

            if (Check(file.Name, file.ContentType, file.Size) is { } reason)
            {
                await RejectAsync(file.Name, file.ContentType, file.Size, reason);
                continue;
            }

            string? preview = null;
            if (Attachment.InferKind(file.ContentType, file.Name) is AttachmentKind.Image && _fileInput?.Element is { } input)
            {
                preview = await Interop.InvokeAsync<string?>("previewFromInput", input, position, file.Name);
            }

            try
            {
                // InputFile streams in chunks, so this is bounded by the limit and not by the circuit's
                // message size.
                await StageAsync(
                    file.Name,
                    file.ContentType,
                    file.Size,
                    ct => ValueTask.FromResult(file.OpenReadStream(MaxAttachmentSize, ct)),
                    preview,
                    owner: null);
            }
            catch (Exception exception) when (IsReadFailure(exception))
            {
                await RevokePreviewAsync(preview);
                await RejectAsync(file.Name, file.ContentType, file.Size, AttachmentRejectionReason.ReadFailed);
            }
        }
    }

    private async Task RemoveAttachmentAsync(Attachment attachment)
    {
        _attachments.Remove(attachment);
        if (_staged.Remove(attachment.AttachmentId, out var staged)) await ReleaseAsync(staged);
    }

    /// <summary>Called from the browser when the user pastes a file into the composer.</summary>
    /// <param name="file">
    /// The pasted file. Its content arrives as a stream, and is withheld when the browser has already
    /// found the file too large.
    /// </param>
    /// <returns>A task that completes when the file has been staged or rejected.</returns>
    [JSInvokable]
    public async Task OnPastedFile(ComposerFile file)
    {
        ArgumentNullException.ThrowIfNull(file);
        if (_disposed) return;

        if (Check(file.Name, file.ContentType, file.Size) is { } reason)
        {
            await ReleaseAsync(file.Content);
            await RevokePreviewAsync(file.PreviewUrl);
            await RejectAsync(file.Name, file.ContentType, file.Size, reason);
        }
        else
        {
            try
            {
                var attachment = await file.ToAttachmentAsync(MaxAttachmentSize, MaxInlineSize);
                _attachments.Add(attachment);
                // A buffered file has released its stream already; a lazy one still needs it.
                _staged[attachment.AttachmentId] = new StagedResources(
                    attachment.ContentFactory is not null ? file.Content : null,
                    file.PreviewUrl);
            }
            catch (Exception exception) when (IsReadFailure(exception))
            {
                await ReleaseAsync(file.Content);
                await RevokePreviewAsync(file.PreviewUrl);
                await RejectAsync(file.Name, file.ContentType, file.Size, AttachmentRejectionReason.ReadFailed);
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Called from the browser when the user drops a file onto the composer.</summary>
    /// <param name="file">The dropped file.</param>
    /// <returns>A task that completes when the attachment has been staged.</returns>
    [JSInvokable]
    public Task OnDroppedFile(ComposerFile file) => OnPastedFile(file);

    /// <summary>Called from the browser as a drag enters or leaves the composer.</summary>
    /// <param name="dragging">Whether a drag is currently over the composer.</param>
    /// <returns>A task that completes when the state has been applied.</returns>
    [JSInvokable]
    public Task OnDragStateChanged(bool dragging)
    {
        if (_disposed) return Task.CompletedTask;
        _dragging = dragging;
        return InvokeAsync(StateHasChanged);
    }

    /// <remarks>
    /// Buffers a small file and keeps a large one in the browser, to be read when the attachment is
    /// opened. <paramref name="owner"/> is the browser stream behind <paramref name="open"/>, when
    /// there is one, so it can be released with the attachment.
    /// </remarks>
    private async Task StageAsync(
        string name,
        string contentType,
        long size,
        Func<CancellationToken, ValueTask<Stream>> open,
        string? previewUrl,
        IJSStreamReference? owner)
    {
        Attachment attachment;
        if (size <= MaxInlineSize)
        {
            await using var stream = await open(CancellationToken.None);
            using var buffer = new MemoryStream((int)Math.Clamp(size, 0, int.MaxValue));
            await stream.CopyToAsync(buffer);
            attachment = ComposerFile.CreateAttachment(name, contentType, buffer.ToArray(), previewUrl);
            await ReleaseAsync(owner);
            owner = null;
        }
        else
        {
            attachment = ComposerFile.CreateLazyAttachment(name, contentType, size, open, previewUrl);
        }

        _attachments.Add(attachment);
        _staged[attachment.AttachmentId] = new StagedResources(owner, previewUrl);
    }

    private AttachmentRejectionReason? Check(string name, string contentType, long size)
    {
        if (_attachments.Count >= MaxAttachments) return AttachmentRejectionReason.TooMany;
        if (!IsAccepted(name, contentType)) return AttachmentRejectionReason.TypeNotAllowed;
        if (size > MaxAttachmentSize) return AttachmentRejectionReason.TooLarge;
        return null;
    }

    /// <remarks>
    /// Mirrors the browser's reading of the accept attribute, which the picker applies but a paste
    /// or a drop does not.
    /// </remarks>
    private bool IsAccepted(string name, string contentType)
    {
        var accept = EffectiveAccept;
        if (string.IsNullOrWhiteSpace(accept)) return true;

        foreach (var token in accept.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
        {
            var matches = token.StartsWith('.')
                ? name.EndsWith(token, StringComparison.OrdinalIgnoreCase)
                : token.EndsWith("/*", StringComparison.Ordinal)
                    ? contentType.StartsWith(token[..^1], StringComparison.OrdinalIgnoreCase)
                    : string.Equals(token, contentType, StringComparison.OrdinalIgnoreCase);

            if (matches) return true;
        }

        return false;
    }

    private string? AcceptFromCapabilities()
    {
        if (EffectiveCapabilities is not { } capabilities) return null;

        var accepted = new List<string>(4);
        if (capabilities.HasFlag(ModelCapabilities.Vision)) accepted.Add("image/*");
        if (capabilities.HasFlag(ModelCapabilities.Audio)) accepted.Add("audio/*");
        if (capabilities.HasFlag(ModelCapabilities.Documents))
        {
            accepted.Add("application/pdf");
            accepted.Add(".pdf");
            accepted.Add("text/*");
        }

        return accepted.Count == 0 ? null : string.Join(',', accepted);
    }

    private static bool IsReadFailure(Exception exception) => exception
        is IOException or JSException or JSDisconnectedException or InvalidOperationException
        or ArgumentException or FormatException or OperationCanceledException;

    private static async Task ReleaseAsync(IJSStreamReference? content)
    {
        if (content is null) return;

        try
        {
            await content.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (ObjectDisposedException) { }
        catch (OperationCanceledException) { }
    }

    private async Task ReleaseAsync(StagedResources staged)
    {
        await ReleaseAsync(staged.Content);
        await RevokePreviewAsync(staged.PreviewUrl);
    }

    private ValueTask RevokePreviewAsync(string? previewUrl) => string.IsNullOrEmpty(previewUrl)
        ? ValueTask.CompletedTask
        : Interop.InvokeVoidAsync("revokePreview", previewUrl);

    private async Task RejectAsync(string name, string contentType, long size, AttachmentRejectionReason reason)
    {
        var rejection = new AttachmentRejection(name, contentType, size, reason);

        _rejections.Add(rejection);
        if (_rejections.Count > MaxNotices) _rejections.RemoveAt(0);

        await OnAttachmentRejected.InvokeAsync(rejection);
    }

    private string RejectionMessage(AttachmentRejection rejection) => rejection.Reason switch
    {
        AttachmentRejectionReason.TooLarge => Strings.AttachmentTooLarge(rejection.FileName, MaxAttachmentSize),
        AttachmentRejectionReason.TooMany => Strings.AttachmentTooMany(rejection.FileName, MaxAttachments),
        AttachmentRejectionReason.TypeNotAllowed => Strings.AttachmentTypeNotAllowed(rejection.FileName),
        _ => Strings.AttachmentReadFailed(rejection.FileName),
    };

    private void DismissRejections() => _rejections.Clear();

    private async Task UpdateMenuAsync()
    {
        CloseMenu();
        if (Value.Length == 0) return;
        if (Commands is not { Count: > 0 } && Mentions is not { Count: > 0 }) return;

        // The caret is only asked for when a menu could open, so ordinary typing costs no round trip.
        // Without a browser to ask, the caret is assumed to be at the end, where typing usually is.
        if (Value.AsSpan().IndexOfAny('/', '@') < 0) return;
        var caret = await Interop.InvokeAsync<int?>("getCaret", _textarea) ?? Value.Length;
        if (_disposed) return;

        UpdateMenu(Math.Clamp(caret, 0, Value.Length));
    }

    private void UpdateMenu(int caret)
    {
        var start = caret - 1;
        while (start >= 0 && !char.IsWhiteSpace(Value[start]) && Value[start] is not ('/' or '@')) start--;
        if (start < 0) return;

        var trigger = Value[start];
        if (trigger is not ('/' or '@')) return;
        if (start > 0 && !char.IsWhiteSpace(Value[start - 1])) return;
        if (trigger == '/' && start != 0) return;

        var query = Value[(start + 1)..caret];
        if (query.Contains(' ')) return;

        if (trigger == '/' && Commands is { Count: > 0 } commands)
        {
            foreach (var command in commands)
            {
                if (!command.Name.Contains(query, StringComparison.OrdinalIgnoreCase)) continue;
                _menuItems.Add(new MenuEntry($"/{command.Name}", command.Description, command.Icon, command, null));
            }
        }
        else if (trigger == '@' && Mentions is { Count: > 0 } mentions)
        {
            foreach (var mention in mentions)
            {
                if (!mention.Label.Contains(query, StringComparison.OrdinalIgnoreCase)) continue;
                _menuItems.Add(new MenuEntry(mention.Label, mention.Description, mention.Icon, null, mention));
            }
        }

        if (_menuItems.Count == 0) return;

        _menuTrigger = trigger;
        _menuStart = start;
        _menuEnd = caret;
        _menuIndex = 0;
    }

    /// <remarks>
    /// Only the trigger and the query typed after it, up to the caret, are replaced. Text after the
    /// caret is kept, so a mention inserted into the middle of a sentence does not cut it short, and
    /// the caret lands just after the inserted text.
    /// </remarks>
    private async Task AcceptMenuItemAsync(int index)
    {
        if (index < 0 || index >= _menuItems.Count) return;

        var entry = _menuItems[index];
        var start = _menuStart >= 0 ? Math.Min(_menuStart, Value.Length) : Value.Length;
        var end = Math.Clamp(_menuEnd, start, Value.Length);
        var prefix = Value[..start];
        var suffix = Value[end..];
        CloseMenu();

        if (entry.Command is { Handler: { } handler })
        {
            Value = prefix + suffix;
            await ValueChanged.InvokeAsync(Value);
            await SaveDraftAsync();
            await handler();
            return;
        }

        var inserted = entry.Command is { } command
            ? command.Template ?? $"/{command.Name} "
            : $"@{entry.Mention!.Label} ";

        // The inserted text ends in a space so typing can carry on; do not double the one that follows.
        if (inserted.EndsWith(' ') && suffix.StartsWith(' ')) suffix = suffix[1..];

        Value = prefix + inserted + suffix;
        _pendingCaret = prefix.Length + inserted.Length;
        await ValueChanged.InvokeAsync(Value);
        await SaveDraftAsync();
    }

    private string OptionId(int index) => $"{_menuId}-{index}";

    private void CloseMenu()
    {
        _menuItems.Clear();
        _menuIndex = 0;
        _menuStart = -1;
        _menuEnd = -1;
        _menuTrigger = '\0';
    }

    /// <inheritdoc />
    /// <remarks>
    /// The renderer disposes a component through <see cref="IAsyncDisposable"/> only, so the browser
    /// listeners, the staged files, and the object reference are all released here. Files already
    /// submitted belong to their message and are left alone.
    /// </remarks>
    protected override async ValueTask DisposeCoreAsync()
    {
        _disposed = true;

        try
        {
            if (_registeredMaxSize is not null)
            {
                _registeredMaxSize = null;
                await Interop.InvokeVoidAsync("unregisterPaste", _textarea);
                await Interop.InvokeVoidAsync("unregisterDrop", _root);
            }

            if (_registeredSubmitOnEnter is not null)
            {
                _registeredSubmitOnEnter = null;
                await Interop.InvokeVoidAsync("unregisterSubmitKey", _textarea);
            }

            foreach (var staged in _staged.Values) await ReleaseAsync(staged);
            _staged.Clear();
        }
        finally
        {
            _self?.Dispose();
            _self = null;
        }
    }

    private sealed record MenuEntry(
        string Label,
        string? Description,
        string? Icon,
        SlashCommand? Command,
        MentionItem? Mention);

    /// <summary>What a staged attachment holds in the browser, to be released when it is discarded.</summary>
    private sealed record StagedResources(IJSStreamReference? Content, string? PreviewUrl);
}

@code {
    /// <summary>
    /// What the composer hands over when the user submits.
    /// </summary>
    /// <param name="Text">The trimmed text.</param>
    /// <param name="Attachments">The files staged alongside it.</param>
    public sealed record PromptSubmission(string Text, IReadOnlyList<Attachment> Attachments);
}
