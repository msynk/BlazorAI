@namespace Blazor.AI.Components
@inherits AiComponentBase
@inject AiInterop Interop

@*
    Dictation using the browser speech API, with no server round trip and no audio leaving the
    device.

    The button hides itself entirely when the browser cannot transcribe, rather than showing a
    control that does nothing when pressed.
*@

@if (_supported)
{
    <button type="button"
            class="bai-btn bai-btn--icon @(_listening ? "bai-btn--active" : null)"
            title="@(_listening ? Strings.StopDictation : Strings.StartDictation)"
            aria-label="@(_listening ? Strings.StopDictation : Strings.StartDictation)"
            aria-pressed="@(_listening ? "true" : "false")"
            @onclick="ToggleAsync">
        <AiIcon Name="mic" />
    </button>

    @* The pressed state alone does not say that the microphone is live; this does, politely. *@
    <span class="bai-sr-only" role="status" aria-live="polite">@_status</span>
}

@code {
    private DotNetObjectReference<VoiceInput>? _self;
    private bool _supported;
    private bool _listening;
    private bool _disposed;
    private int _handle;
    private string? _status;

    /// <summary>Raised with each finalised phrase.</summary>
    [Parameter]
    public EventCallback<string> OnTranscript { get; set; }

    /// <summary>Raised with the provisional text as the user speaks.</summary>
    [Parameter]
    public EventCallback<string> OnInterim { get; set; }

    /// <summary>Raised when transcription fails, for example when the microphone is refused.</summary>
    [Parameter]
    public EventCallback<string> OnError { get; set; }

    /// <summary>Raised when dictation starts or stops, however that happens.</summary>
    [Parameter]
    public EventCallback<bool> OnListeningChanged { get; set; }

    /// <summary>The recognition language. Defaults to the browser language.</summary>
    [Parameter]
    public string? Language { get; set; }

    /// <summary>Whether dictation is running.</summary>
    public bool IsListening => _listening;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;

        _self = DotNetObjectReference.Create(this);
        _supported = await Interop.InvokeAsync<bool>("isDictationSupported");
        if (_supported && !_disposed) StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        if (_listening)
        {
            await Interop.InvokeVoidAsync("stopDictation", _handle);
            await SetListeningAsync(false, Strings.DictationStopped);
            return;
        }

        _handle = await Interop.InvokeAsync<int>("startDictation", _self, Language);
        if (_handle > 0) await SetListeningAsync(true, Strings.Listening);
    }

    /// <summary>Called from the browser with recognised speech.</summary>
    /// <param name="final">Text the recogniser has committed to.</param>
    /// <param name="interim">Provisional text that may still change.</param>
    /// <returns>A task that completes once the callbacks have run.</returns>
    [JSInvokable]
    public async Task OnTranscriptReceived(string? final, string? interim)
    {
        if (_disposed) return;
        if (!string.IsNullOrWhiteSpace(final)) await OnTranscript.InvokeAsync(final.Trim());
        // An empty interim clears the provisional text the previous one showed.
        await OnInterim.InvokeAsync(interim ?? string.Empty);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Called from the browser when transcription fails.</summary>
    /// <param name="error">The reported error name.</param>
    /// <returns>A task that completes once the callback has run.</returns>
    [JSInvokable]
    public async Task OnDictationError(string error)
    {
        if (_disposed) return;
        _handle = 0;
        await SetListeningAsync(false, Strings.DictationFailed(error));
        await OnError.InvokeAsync(error);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Called from the browser when transcription stops on its own.</summary>
    /// <returns>A task that completes when the state has been applied.</returns>
    [JSInvokable]
    public async Task OnDictationEnded()
    {
        if (_disposed) return;
        _handle = 0;
        if (_listening) await SetListeningAsync(false, Strings.DictationStopped);
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetListeningAsync(bool listening, string status)
    {
        var changed = _listening != listening;
        _listening = listening;
        _status = status;
        if (changed) await OnListeningChanged.InvokeAsync(listening);
    }

    /// <inheritdoc />
    /// <remarks>
    /// Removing the button must not leave the microphone running with nothing able to stop it, and
    /// the object reference must go with the component or the browser keeps calling into a ghost.
    /// </remarks>
    protected override async ValueTask DisposeCoreAsync()
    {
        _disposed = true;

        try
        {
            if (_listening)
            {
                _listening = false;
                await Interop.InvokeVoidAsync("stopDictation", _handle);
            }
        }
        finally
        {
            _self?.Dispose();
            _self = null;
        }
    }
}
