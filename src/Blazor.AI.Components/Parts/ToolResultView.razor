@namespace Blazor.AI.Components
@inherits AiComponentBase

@*
    A tool result that arrived without a matching call, which happens with providers that emit tool
    output as its own message.
*@

<div class="bai-panel">
    <div class="bai-panel__header" style="cursor:default">
        <AiIcon Name="tool" />
        <span class="bai-panel__title">@(Part.ToolName ?? Strings.Result)</span>
    </div>
    <div class="bai-panel__body">
        @if (!Part.Outcome.IsSuccess && Part.Outcome.Error is { } error)
        {
            <ErrorView Error="error" Compact="true" />
        }
        else if (Part.Outcome.Text is { Length: > 0 } text)
        {
            <div class="bai-json__row">@text</div>
        }
        else if (Part.Outcome.Value is { } value)
        {
            <JsonView Value="value" />
        }
    </div>
</div>

@code {
    /// <summary>The result to render.</summary>
    [Parameter, EditorRequired]
    public ToolResultPart Part { get; set; } = default!;
}
