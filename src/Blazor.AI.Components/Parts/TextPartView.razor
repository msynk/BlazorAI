@namespace Blazor.AI.Components
@inherits AiComponentBase

@*
    Renders a text part as Markdown, with anchored citations woven into the source.

    Anchored citations carry character offsets rather than markers. Inserting a marker at each
    offset before parsing is what lets a superscript land mid-sentence where the claim actually sits,
    instead of being appended as a footnote nobody connects to anything.
*@

<StreamingMarkdown Text="@_source"
                   IsStreaming="@Part.IsStreaming"
                   Citations="Message.Citations"
                   OnCitationClick="OnCitationClick"
                   Class="@Class" />

@code {
    private string? _source;
    private int _sourceVersion = -1;
    private int _citationCount = -1;

    /// <summary>The part to render.</summary>
    [Parameter, EditorRequired]
    public TextPart Part { get; set; } = default!;

    /// <summary>The message the part belongs to, used to resolve citations.</summary>
    [Parameter, EditorRequired]
    public AiMessage Message { get; set; } = default!;

    /// <summary>Raised when the user activates a citation marker.</summary>
    [Parameter]
    public EventCallback<Citation> OnCitationClick { get; set; }

    /// <summary>Extra CSS classes.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (_sourceVersion == Part.Version && _citationCount == Message.Citations.Count) return;

        _sourceVersion = Part.Version;
        _citationCount = Message.Citations.Count;
        _source = Options.InlineCitations ? WithCitationMarkers(Part, Message) : Part.Text;
    }

    /// <summary>
    /// Inserts numbered markers at the end of every citation span that falls inside this part.
    /// </summary>
    /// <remarks>
    /// Spans that reach past the text received so far are skipped: during streaming they will be
    /// valid a moment later, and inserting them early would place a marker in the wrong sentence.
    /// </remarks>
    private static string WithCitationMarkers(TextPart part, AiMessage message)
    {
        var text = part.Text;

        var anchored = message.Citations
            .Where(c => c.IsAnchored && (c.PartId is null || c.PartId == part.PartId))
            .Where(c => c.EndIndex is { } end && end <= text.Length)
            .OrderByDescending(c => c.EndIndex)
            .ToArray();

        if (anchored.Length == 0) return text;

        var builder = new System.Text.StringBuilder(text.Length + anchored.Length * 4);
        builder.Append(text);

        foreach (var citation in anchored)
        {
            builder.Insert(citation.EndIndex!.Value, $"[{citation.Number}]");
        }

        return builder.ToString();
    }
}
