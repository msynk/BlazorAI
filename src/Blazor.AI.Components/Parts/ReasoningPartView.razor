@namespace Blazor.AI.Components
@inherits AiComponentBase

@*
    The collapsible panel that holds model reasoning.

    Open while the model is still thinking, so the user sees progress rather than a spinner, and
    collapsed once the answer starts arriving (when CollapseReasoning is on), so the reasoning does
    not compete with it. A user who opened or closed the panel by hand wins over both defaults.
*@

<AiCollapsible Class="bai-reasoning"
               Open="@_open"
               OpenChanged="OnUserToggled">
    <Header>
        <AiIcon Name="brain" />
        <span class="bai-panel__title">@Title</span>
        @if (Part.IsStreaming)
        {
            <span class="bai-thinking__dots" aria-hidden="true">
                <span class="bai-thinking__dot"></span>
                <span class="bai-thinking__dot"></span>
                <span class="bai-thinking__dot"></span>
            </span>
        }
    </Header>
    <ChildContent>
        <StreamingMarkdown Text="@Part.Text" IsStreaming="@Part.IsStreaming" Class="bai-reasoning__body" />
    </ChildContent>
</AiCollapsible>

@code {
    private bool _open;
    private bool _userDecided;
    private bool _wasStreaming;
    private ReasoningPart? _subscribed;

    /// <summary>The reasoning to render.</summary>
    [Parameter, EditorRequired]
    public ReasoningPart Part { get; set; } = default!;

    private string Title => Part.Duration is { } duration && !Part.IsStreaming
        ? Strings.ReasonedFor(duration)
        : Strings.Reasoning;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribed, Part))
        {
            if (_subscribed is not null) _subscribed.Changed -= OnPartChanged;
            _subscribed = Part;
            _subscribed.Changed += OnPartChanged;
            _userDecided = false;
            _wasStreaming = Part.IsStreaming;
            _open = Part.IsStreaming || !Options.CollapseReasoning;
        }

        ApplyAutoState();
    }

    private void OnPartChanged(MessagePart part)
    {
        ApplyAutoState();
        RequestRender();
    }

    private void ApplyAutoState()
    {
        if (_wasStreaming == Part.IsStreaming) return;
        _wasStreaming = Part.IsStreaming;

        // Streaming just finished: collapse unless the host wants reasoning visible or the user
        // already made a choice.
        if (!Part.IsStreaming && !_userDecided && Options.CollapseReasoning) _open = false;
    }

    private void OnUserToggled(bool open)
    {
        _open = open;
        _userDecided = true;
    }

    /// <inheritdoc />
    protected override ValueTask DisposeCoreAsync()
    {
        if (_subscribed is not null) _subscribed.Changed -= OnPartChanged;
        _subscribed = null;
        return ValueTask.CompletedTask;
    }
}
