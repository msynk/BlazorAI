@namespace Blazor.AI.Components
@inherits AiComponentBase

@*
    One source. A link when the source is addressable, so the browser gives the user the usual
    middle-click and context-menu affordances; a button otherwise.
*@

@if (SafeUrl(Source.Url) is { } url && !OnActivate.HasDelegate)
{
    <a class="bai-source" href="@url" target="_blank" rel="noopener noreferrer">
        @Body()
    </a>
}
else
{
    <button type="button" class="bai-source" style="text-align:left" @onclick="() => OnActivate.InvokeAsync(Source)">
        @Body()
    </button>
}

@code {
    /// <summary>The source to render.</summary>
    [Parameter, EditorRequired]
    public CitationSource Source { get; set; } = default!;

    /// <summary>The marker number shown beside the title.</summary>
    [Parameter]
    public int? Number { get; set; }

    /// <summary>Raised when the card is activated. When set, the card becomes a button.</summary>
    [Parameter]
    public EventCallback<CitationSource> OnActivate { get; set; }

    private RenderFragment Body() => __builder =>
    {
        @if (Number is { } number && number != int.MaxValue)
        {
            <span class="bai-source__index">@number</span>
        }
        <span class="bai-source__body">
            <span class="bai-source__title">@Source.Title</span>
            <span class="bai-source__site">
                @if (SafeIconUrl(Source.IconUrl) is { } icon)
                {
                    <img class="bai-source__favicon" src="@icon" alt="" loading="lazy" referrerpolicy="no-referrer" />
                }
                @(Source.SiteName ?? HostOf(Source.Url) ?? Source.Kind.ToString())
            </span>
        </span>
    };

    /// <summary>
    /// Returns the URL only when it is an absolute web address.
    /// </summary>
    /// <remarks>
    /// Source URLs come from the model or from retrieved content, and Blazor writes an href as
    /// given, so a javascript: URL would run in the host page when clicked. Anything that is not
    /// http or https renders as a plain card instead of a link.
    /// </remarks>
    internal static string? SafeUrl(string? url) =>
        Uri.TryCreate(url?.Trim(), UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp)
            ? url!.Trim()
            : null;

    /// <summary>
    /// Returns an icon URL only when it is a web address or an inline image, the two forms a
    /// favicon legitimately takes. An image src is less exposed than an href, but a data: URL of a
    /// non-image type or a scheme the browser hands to a plugin is still not worth loading.
    /// </summary>
    internal static string? SafeIconUrl(string? url)
    {
        if (SafeUrl(url) is { } web) return web;

        var trimmed = url?.Trim();
        return trimmed is not null && trimmed.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase)
            && !trimmed.Contains("svg", StringComparison.OrdinalIgnoreCase)
            ? trimmed
            : null;
    }

    private static string? HostOf(string? url) =>
        SafeUrl(url) is { } safe && Uri.TryCreate(safe, UriKind.Absolute, out var uri) ? uri.Host : null;
}
