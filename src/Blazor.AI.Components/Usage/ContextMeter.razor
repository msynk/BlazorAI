@namespace Blazor.AI.Components
@inherits AiComponentBase

@*
    How much of the context window the conversation is using.

    Worth showing because running out of context is the failure users understand least: the model
    simply starts forgetting. A meter that turns amber before it happens is far kinder than an error
    afterwards.
*@

@if (Window is { } window && window > 0)
{
    <div class="bai-usage" title="@($"{Used:N0} / {window:N0} tokens")">
        <span>@Strings.Context</span>
        <div class="bai-meter @Severity" role="progressbar"
             aria-valuenow="@((int)(Fraction * 100))" aria-valuemin="0" aria-valuemax="100"
             aria-label="@Strings.Context">
            <div class="bai-meter__fill" style="width:@($"{Math.Min(1, Fraction) * 100:0}%")"></div>
        </div>
        <span>@($"{Fraction * 100:0}%")</span>
    </div>
}

@code {
    /// <summary>Tokens used so far.</summary>
    [Parameter]
    public long Used { get; set; }

    /// <summary>The size of the context window.</summary>
    [Parameter]
    public long? Window { get; set; }

    /// <summary>
    /// Reads the used tokens and window from a conversation instead of taking them directly.
    /// </summary>
    [Parameter]
    public Conversation? Conversation { get; set; }

    /// <summary>Supplies the window when the conversation does not carry one.</summary>
    [Parameter]
    public AiModel? Model { get; set; }

    private double Fraction => Window is { } window && window > 0 ? (double)Used / window : 0;

    private string? Severity => Fraction switch
    {
        >= 0.9 => "bai-meter--danger",
        >= 0.75 => "bai-meter--warning",
        _ => null,
    };

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Conversation is { } conversation)
        {
            Used = conversation.TotalUsage.TotalTokens ?? Used;
            Window ??= conversation.Messages
                .Select(m => m.Metadata?.ContextWindow)
                .LastOrDefault(w => w is not null);
        }

        Window ??= Model?.ContextWindow;
    }
}
