@namespace Blazor.AI.Components
@inherits AiComponentBase

@*
    How much of the context window the conversation is using.

    Worth showing because running out of context is the failure users understand least: the model
    simply starts forgetting. A meter that turns amber before it happens is far kinder than an error
    afterwards.
*@

@if (_window is { } window && window > 0)
{
    <div class="bai-usage @Severity" title="@Strings.ContextUsage(_used, window)">
        <span>@Strings.Context</span>
        <div class="bai-meter @Severity" role="progressbar"
             aria-valuenow="@((int)(Math.Min(1, Fraction) * 100))" aria-valuemin="0" aria-valuemax="100"
             aria-valuetext="@Strings.ContextUsage(_used, window)"
             aria-label="@Strings.Context">
            <div class="bai-meter__fill" style="width:@($"{Math.Min(1, Fraction) * 100:0}%")"></div>
        </div>
        <span>@($"{Fraction * 100:0}%")</span>
        @if (Fraction >= Critical)
        {
            <span class="bai-sr-only" role="status">@Strings.ContextCritical</span>
        }
        else if (Fraction >= Warn)
        {
            <span class="bai-sr-only" role="status">@Strings.ContextWarning</span>
        }
    </div>
}

@code {
    /// <summary>Tokens used so far. Overridden by <see cref="Conversation"/> when it carries usage.</summary>
    [Parameter]
    public long Used { get; set; }

    /// <summary>The size of the context window.</summary>
    [Parameter]
    public long? Window { get; set; }

    /// <summary>
    /// Reads the used tokens and window from a conversation instead of taking them directly.
    /// </summary>
    [Parameter]
    public Conversation? Conversation { get; set; }

    /// <summary>Supplies the window when the conversation does not carry one.</summary>
    [Parameter]
    public AiModel? Model { get; set; }

    /// <summary>
    /// An estimate of tokens about to be added, such as the prompt being typed, counted on top of
    /// what the conversation has used.
    /// </summary>
    [Parameter]
    public long PendingTokens { get; set; }

    /// <summary>The fraction at which the meter turns to warning styling. Defaults to 0.8.</summary>
    [Parameter]
    public double Warn { get; set; } = 0.8;

    /// <summary>The fraction at which the meter turns to critical styling. Defaults to 0.95.</summary>
    [Parameter]
    public double Critical { get; set; } = 0.95;

    // Derived values live in fields rather than being written back into the parameters: a parameter
    // the parent does not pass is never reset, so a window filled in once would stick even after
    // the model or the conversation changed.
    private long _used;
    private long? _window;

    private double Fraction => _window is { } window && window > 0 ? (double)_used / window : 0;

    private string? Severity => Fraction switch
    {
        var f when f >= Critical => "bai-meter--danger",
        var f when f >= Warn => "bai-meter--warning",
        _ => null,
    };

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _used = Used;
        _window = Window;

        if (Conversation is { } conversation)
        {
            var (used, window) = Measure(conversation);
            if (used is { } value) _used = value;
            _window ??= window;
        }

        _used += PendingTokens;
        _window ??= Model?.ContextWindow;
    }

    /// <summary>
    /// Works out how full the context is from a conversation.
    /// </summary>
    /// <param name="conversation">The conversation.</param>
    /// <returns>
    /// The tokens the next request will carry and the window size, either of which is
    /// <see langword="null"/> when the conversation does not report it.
    /// </returns>
    /// <remarks>
    /// The right figure is the latest assistant message's prompt plus its output, because the next
    /// request sends the whole thread again and that message's input tokens already cover it. Summing
    /// every turn's usage, as a total-cost readout does, counts the early turns once per later turn
    /// and runs the meter to the top long before the model forgets anything.
    /// </remarks>
    public static (long? Used, long? Window) Measure(Conversation conversation)
    {
        ArgumentNullException.ThrowIfNull(conversation);

        long? used = null;
        long? window = null;
        var messages = conversation.Messages;

        for (var i = messages.Count - 1; i >= 0; i--)
        {
            var metadata = messages[i].Metadata;
            if (metadata is null) continue;

            window ??= metadata.ContextWindow;

            if (used is null && messages[i].Role == AiRole.Assistant && metadata.Usage.TotalTokens is { } total)
            {
                used = total;
            }

            if (used is not null && window is not null) break;
        }

        return (used, window);
    }
}
