<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>Blazor.AI.GenerativeUI</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Typed, sandboxed generative UI: component registries, schema description, and safe binding of AI-produced structured data to Blazor components.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Blazor.AI.Core/Blazor.AI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.AspNetCore.Components" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

</Project>
